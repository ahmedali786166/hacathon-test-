# Backend AI API Key (Server-side only)
AI_API_KEY="MY_AI_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Port configuration
PORT=3000

# Authentication secret
JWT_SECRET="replace-with-a-secure-random-secret-in-production"

# Hosted database (Turso Cloud / libSQL). When set, these override the local file.
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Local SQLite file fallback used when TURSO_DATABASE_URL is not set
DATABASE_FILE="hcm_lite.sqlite"
